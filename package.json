{
  "name": "numerology-vip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/gen-sitemap.mjs dist/sitemap.xml",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:storage": "firebase deploy --only storage",
    "seo:sitemap": "node scripts/gen-sitemap.mjs public/sitemap.xml",
    "seo:index": "node scripts/gen-sitemap-index.mjs",
    "seo:og": "node scripts/gen-og-image.mjs",
    "seo:check": "node scripts/verify-seo.mjs && node scripts/verify-prerender.mjs"
  },
  "dependencies": {
    "firebase": "^10.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
