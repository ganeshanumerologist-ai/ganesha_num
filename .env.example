# Firebase Configuration (copy to .env and fill your real values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ---- OTP / SMS login ----
# Firebase ka test phone number (ek se zyada ho to comma se alag karke).
#
# In numbers par koi SMS nahi jaata — Firebase console me dikhaya hua FIXED
# OTP chal jaata hai, aur ye FREE (Spark) plan par bhi kaam karta hai.
# Asli SMS ke liye Blaze (billing) plan chahiye hoga.
#
# Kaise banayein:
#   Firebase Console -> Authentication -> Phone -> "Phone numbers for testing"
#   wahan number add karke neeche ek code dikhega, us number ko yahan likh do.
#
# Test number ki list (yaad rakhiye — E.164 format me, + se shuru):
# VITE_FIREBASE_TEST_PHONES=""
